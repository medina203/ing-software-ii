// Prisma schema para PostgreSQL
// Sistema de Administración de Inventario y Alquiler de Implementos de Construcción

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMIN
  EMPLEADO
}

enum EstadoImplemento {
  DISPONIBLE
  ALQUILADO
  MANTENIMIENTO
  FUERA_DE_SERVICIO
}

enum EstadoAlquiler {
  ACTIVO
  FINALIZADO
  VENCIDO
}

enum EstadoEntrega {
  DISPONIBLE
  MANTENIMIENTO
  FUERA_DE_SERVICIO
}

enum EstadoFactura {
  PENDIENTE
  PAGADA
  VENCIDA
}

enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  OTRO
}

model Usuario {
  id           Int      @id @default(autoincrement())
  nombre       String   @db.VarChar(120)
  email        String   @unique @db.VarChar(160)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  rol          Rol      @default(EMPLEADO)
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Último restablecimiento de contraseña: invalida las sesiones abiertas antes de esa fecha.
  passwordRestablecidaEn DateTime? @map("password_restablecida_en") @db.Timestamptz(6)

  alquileres                Alquiler[]
  devoluciones              Devolucion[]
  pagos                     Pago[]
  autorizacionesSolicitadas AutorizacionCartera[] @relation("AutorizacionSolicitante")
  autorizacionesOtorgadas   AutorizacionCartera[] @relation("AutorizacionAdministrador")
  tokensRecuperacion        TokenRecuperacion[]

  @@index([rol, activo])
  @@map("usuarios")
}

model Cliente {
  id                 Int      @id @default(autoincrement())
  documentoIdentidad String   @unique @map("documento_identidad") @db.VarChar(30)
  nombres            String   @db.VarChar(100)
  apellidos          String   @db.VarChar(100)
  telefono           String   @db.VarChar(30)
  correo             String?  @db.VarChar(160)
  direccion          String?  @db.VarChar(220)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  alquileres            Alquiler[]
  facturas              Factura[]
  autorizacionesCartera AutorizacionCartera[]

  @@index([apellidos, nombres])
  @@index([telefono])
  @@map("clientes")
}

model Categoria {
  id                Int      @id @default(autoincrement())
  nombre            String   @unique @db.VarChar(100)
  prefijo           String   @unique @db.VarChar(10)
  ultimoConsecutivo Int      @default(0) @map("ultimo_consecutivo")
  descripcion       String?  @db.VarChar(250)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  implementos Implemento[]

  @@map("categorias")
}

model Implemento {
  id                   Int              @id @default(autoincrement())
  codigoSerie          String           @unique @map("codigo_serie") @db.VarChar(50)
  nombre               String           @db.VarChar(140)
  categoriaId          Int              @map("categoria_id")
  descripcion          String?          @db.VarChar(300)
  /// Imagen del tipo de implemento (se comparte entre sus unidades).
  imagenUrl            String?          @map("imagen_url") @db.VarChar(300)
  precioAlquilerDiario Decimal          @map("precio_alquiler_diario") @db.Decimal(12, 2)
  estado               EstadoImplemento @default(DISPONIBLE)
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  categoria    Categoria           @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  detalles     DetalleAlquiler[]
  devoluciones DetalleDevolucion[]

  @@index([estado])
  @@index([categoriaId])
  @@index([nombre])
  @@map("implementos")
}

model Alquiler {
  id                     Int            @id @default(autoincrement())
  codigoAlquiler         String         @unique @map("codigo_alquiler") @db.VarChar(40)
  clienteId              Int            @map("cliente_id")
  usuarioId              Int            @map("usuario_id")
  fechaAlquiler          DateTime       @default(now()) @map("fecha_alquiler") @db.Timestamptz(6)
  fechaPactadaDevolucion DateTime       @map("fecha_pactada_devolucion") @db.Timestamptz(6)
  estado                 EstadoAlquiler @default(ACTIVO)
  observaciones          String?        @db.Text
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  cliente             Cliente              @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  usuario             Usuario              @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  detalles            DetalleAlquiler[]
  devolucion          Devolucion?
  factura             Factura?
  autorizacionCartera AutorizacionCartera?

  @@index([estado, fechaPactadaDevolucion])
  @@index([clienteId])
  @@index([usuarioId])
  @@index([fechaAlquiler])
  @@map("alquileres")
}

model DetalleAlquiler {
  id             Int      @id @default(autoincrement())
  alquilerId     Int      @map("alquiler_id")
  implementoId   Int      @map("implemento_id")
  precioUnitario Decimal  @map("precio_unitario") @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  alquiler   Alquiler   @relation(fields: [alquilerId], references: [id], onDelete: Cascade)
  implemento Implemento @relation(fields: [implementoId], references: [id], onDelete: Restrict)

  @@unique([alquilerId, implementoId])
  @@index([implementoId])
  @@map("detalle_alquileres")
}

model Devolucion {
  id                       Int      @id @default(autoincrement())
  alquilerId               Int      @unique @map("alquiler_id")
  fechaDevolucion          DateTime @default(now()) @map("fecha_devolucion") @db.Timestamptz(6)
  usuarioId                Int      @map("usuario_id")
  estadoEntregaImplementos String   @map("estado_entrega_implementos") @db.VarChar(100)
  alertaCartera            Boolean  @default(false) @map("alerta_cartera")
  saldoCarteraAlerta       Decimal? @map("saldo_cartera_alerta") @db.Decimal(12, 2)
  observaciones            String?  @db.Text
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  alquiler Alquiler            @relation(fields: [alquilerId], references: [id], onDelete: Restrict)
  usuario  Usuario             @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  detalles DetalleDevolucion[]

  @@index([fechaDevolucion])
  @@index([usuarioId])
  @@map("devoluciones")
}

model DetalleDevolucion {
  id            Int           @id @default(autoincrement())
  devolucionId  Int           @map("devolucion_id")
  implementoId  Int           @map("implemento_id")
  estadoFinal   EstadoEntrega @map("estado_final")
  observaciones String?       @db.VarChar(300)

  devolucion Devolucion @relation(fields: [devolucionId], references: [id], onDelete: Cascade)
  implemento Implemento @relation(fields: [implementoId], references: [id], onDelete: Restrict)

  @@unique([devolucionId, implementoId])
  @@index([implementoId])
  @@map("detalle_devoluciones")
}

model Factura {
  id               Int           @id @default(autoincrement())
  codigoFactura    String        @unique @map("codigo_factura") @db.VarChar(40)
  alquilerId       Int           @unique @map("alquiler_id")
  clienteId        Int           @map("cliente_id")
  fechaEmision     DateTime      @default(now()) @map("fecha_emision") @db.Timestamptz(6)
  fechaVencimiento DateTime      @map("fecha_vencimiento") @db.Timestamptz(6)
  total            Decimal       @db.Decimal(12, 2)
  saldo            Decimal       @db.Decimal(12, 2)
  estado           EstadoFactura @default(PENDIENTE)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  alquiler       Alquiler              @relation(fields: [alquilerId], references: [id], onDelete: Restrict)
  cliente        Cliente               @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  pagos          Pago[]
  autorizaciones AutorizacionCartera[]

  @@index([clienteId, estado])
  @@index([fechaVencimiento, estado])
  @@map("facturas")
}

model Pago {
  id         Int        @id @default(autoincrement())
  facturaId  Int        @map("factura_id")
  usuarioId  Int        @map("usuario_id")
  monto      Decimal    @db.Decimal(12, 2)
  metodoPago MetodoPago @default(EFECTIVO) @map("metodo_pago")
  referencia String?    @db.VarChar(120)
  fechaPago  DateTime   @default(now()) @map("fecha_pago") @db.Timestamptz(6)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  factura Factura @relation(fields: [facturaId], references: [id], onDelete: Restrict)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([facturaId, fechaPago])
  @@index([usuarioId])
  @@map("pagos")
}

model AutorizacionCartera {
  id                   Int      @id @default(autoincrement())
  clienteId            Int      @map("cliente_id")
  facturaId            Int      @map("factura_id")
  alquilerId           Int?     @unique @map("alquiler_id")
  usuarioSolicitanteId Int      @map("usuario_solicitante_id")
  administradorId      Int      @map("administrador_id")
  saldoPendiente       Decimal  @map("saldo_pendiente") @db.Decimal(12, 2)
  motivo               String   @db.Text
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  cliente            Cliente   @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  factura            Factura   @relation(fields: [facturaId], references: [id], onDelete: Restrict)
  alquiler           Alquiler? @relation(fields: [alquilerId], references: [id], onDelete: SetNull)
  usuarioSolicitante Usuario   @relation("AutorizacionSolicitante", fields: [usuarioSolicitanteId], references: [id], onDelete: Restrict)
  administrador      Usuario   @relation("AutorizacionAdministrador", fields: [administradorId], references: [id], onDelete: Restrict)

  @@index([clienteId, createdAt])
  @@index([facturaId])
  @@map("autorizaciones_cartera")
}

/// Apariencia del sistema definida por el ADMIN (registro único, id = 1).
model Configuracion {
  id             Int      @id @default(1)
  tema           String   @default("claro") @db.VarChar(10)
  tamanoFuente   String   @default("normal") @map("tamano_fuente") @db.VarChar(10)
  colorPrimario  String   @default("ambar") @map("color_primario") @db.VarChar(20)
  imagenLoginUrl String?  @map("imagen_login_url") @db.VarChar(300)
  carrusel       Json     @default("[]")
  actualizadoPor Int?     @map("actualizado_por")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("configuracion")
}

/// Enlaces de un solo uso para restablecer la contraseña. Solo se guarda el hash del token.
model TokenRecuperacion {
  id        Int       @id @default(autoincrement())
  usuarioId Int       @map("usuario_id")
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiraEn  DateTime  @map("expira_en") @db.Timestamptz(6)
  usadoEn   DateTime? @map("usado_en") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("tokens_recuperacion")
}
