# Copia este archivo como backend/.env
DATABASE_URL="postgresql://inventario:inventario123@localhost:5432/inventario_db?schema=public"

# Cambia este valor por un secreto largo y aleatorio en cualquier entorno real.
JWT_SECRET="desarrollo-cambia-este-secreto-por-uno-largo-y-aleatorio-2026"
JWT_EXPIRES_IN_SECONDS=28800

PORT=4000
FRONTEND_URL="http://localhost:5173"

# Zona horaria del negocio para "hoy", vencimientos y días facturados.
APP_TIMEZONE="America/Bogota"

# Cada cuántos minutos se sincronizan los estados VENCIDO (0 = solo al iniciar).
STATUS_SYNC_INTERVAL_MINUTES=15

# Bloqueo por intentos fallidos de login (RNF-01).
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15

# Carpeta donde se guardan las imágenes subidas (debe persistir entre despliegues).
UPLOADS_DIR="./uploads"

# ---- Solo producción (Railway u otro servidor) ----
# NODE_ENV=production exige un JWT_SECRET propio de al menos 32 caracteres.
# NODE_ENV=production
# Carpeta del frontend compilado; si se define, la API también entrega la página web.
# FRONTEND_DIST="../frontend/dist"
# Administrador que se crea solo si la base de datos no tiene usuarios (primer arranque).
# ADMIN_NAME="Administrador"
# ADMIN_EMAIL="admin@tu-negocio.com"
# ADMIN_PASSWORD="una-clave-segura"

# ---- Recuperación de contraseña por correo (Resend, API HTTPS) ----
# Sin RESEND_API_KEY: en desarrollo el enlace se muestra en la consola de la API;
# en producción la pantalla indica pedir la contraseña al administrador.
# RESEND_API_KEY="re_xxxxxxxxx"
# Remitente. Sin dominio verificado use onboarding@resend.dev (solo llega al correo de su cuenta de Resend).
# MAIL_FROM="DM alquiler <no-responder@tu-dominio.com>"
# Dirección pública para los enlaces del correo (en Railway se toma sola de RAILWAY_PUBLIC_DOMAIN).
# APP_URL="https://tu-sistema.up.railway.app"
# Minutos de vigencia del enlace (5 a 1440).
# PASSWORD_RESET_MINUTES=30
